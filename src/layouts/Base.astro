---
import '../styles/theme.css';
import { site, liveLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = `${site.name} — sets, shows, and every place to follow.`,
} = Astro.props;

// Join a path onto BASE_URL without doubling slashes.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p: string) => `${base}/${p.replace(/^\//, '')}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// PNG, not SVG: no major platform renders an SVG share card (tools/README.md).
const ogImage = new URL(asset('og.png'), Astro.site).href;

// Conventional JSON-LD (decisions.md D8 — modest, not a verified SEO bet).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['MusicGroup', 'LocalBusiness'],
  name: site.name,
  description,
  url: canonical,
  genre: 'Electronic',
  ...(site.locality ? { areaServed: site.locality } : {}),
  // sameAs is the machine-readable half of the link hub: it tells search
  // engines these platform profiles are the same entity as this page.
  sameAs: liveLinks().map((l) => l.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#05060a" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pathway+Gothic+One&family=Bebas+Neue&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <slot />
  </body>
</html>

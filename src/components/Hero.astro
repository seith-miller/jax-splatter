---
import { Image } from 'astro:assets';
// The signed key art (JAX-A005) is the hero — imported straight from the
// release directory so the site can never drift from the registry's file.
import keyArt from '../../brand/releases/JAX-A005_key-art_v1.png';
---

<section id="top" class="hero scanlines" aria-label="Intro">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <h1 class="wm-art">
      <Image
        src={keyArt}
        alt="JAX SPLATTER"
        widths={[480, 768, 1080, 1600]}
        sizes="(max-width: 60rem) 100vw, 56rem"
        loading="eager"
        fetchpriority="high"
        class="key-art"
      />
    </h1>
  </div>
</section>

<style>
  /* Shorter than a full viewport on purpose: the link hub sits immediately
     below and must be visible without a scroll on a phone (decisions.md D9). */
  .hero { min-height: min(46vh, 24rem); display: grid; align-items: center; overflow: hidden; }
  /* Flat #05060a — the exact field color of the JAX-A005 key art, so the
     image sits seamlessly. No gradients behind it: any glow back there
     reveals the art's rectangle. */
  .hero-bg { position: absolute; inset: 0; z-index: 0; background: #05060a; }
  .hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background-image:
      linear-gradient(transparent 0 2px, rgba(70,179,255,0.04) 2px 3px);
    background-size: 100% 3px; opacity: 0.6;
  }
  .hero-inner { position: relative; z-index: 1; padding-block: clamp(2rem, 5vw, 3.25rem); }
  .kicker {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.34em; font-size: 0.85rem; color: var(--blue);
    margin: 0 0 0.75rem;
  }
  h1.wm-art { margin: 0; }
  .key-art {
    display: block; width: auto; height: auto; max-width: 100%;
    /* Height-capped so the link hub still clears the fold (decisions.md D9). */
    max-height: min(50vh, 26rem);
    margin-inline: auto;
  }
  .statement {
    max-width: 34ch; font-size: clamp(1.05rem, 1rem + 0.6vw, 1.4rem);
    color: var(--fg-dim); margin: 1rem 0 0;
  }
</style>

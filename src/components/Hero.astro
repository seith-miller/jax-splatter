---
import { Image } from 'astro:assets';
// The key-art splatter with a transparent field and no release stamp,
// rendered from brand/reference/key-art/key-art.html (the same composition
// the signed JAX-A005 was pressed from). Per Jax 2026-08-27: the art's words
// must occupy exactly the space the text wordmark did.
import keyArt from '../../brand/reference/key-art/key-art-wide-transparent.png';
---

<section id="top" class="hero scanlines" aria-label="Intro">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <h1 class="wm-art">
      <!-- Invisible copy of the old text wordmark: it alone defines the h1's
           box, so swapping the art in cannot move the page layout. -->
      <span class="ghost" aria-hidden="true">JA<span class="x">X</span><span class="wgap"></span>SPLATTER</span>
      <Image
        src={keyArt}
        alt="JAX SPLATTER"
        widths={[480, 880, 1320, 1760]}
        sizes="max(402px, min(64vw, 878px))"
        loading="eager"
        fetchpriority="high"
        class="key-art"
      />
    </h1>
  </div>
</section>

<style>
  /* Shorter than a full viewport on purpose: the link hub sits immediately
     below and must be visible without a scroll on a phone (decisions.md D9). */
  .hero { min-height: min(46vh, 24rem); display: grid; align-items: center; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(80% 60% at 75% 15%, rgba(70,179,255,0.20), transparent 55%),
      radial-gradient(70% 50% at 15% 95%, rgba(255,45,85,0.14), transparent 55%),
      linear-gradient(180deg, #06080e 0%, #05060a 60%, #04050a 100%);
  }
  .hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background-image:
      linear-gradient(transparent 0 2px, rgba(70,179,255,0.04) 2px 3px);
    background-size: 100% 3px; opacity: 0.6;
  }
  .hero-inner { position: relative; z-index: 1; padding-block: clamp(2rem, 5vw, 3.25rem); }
  h1.wm-art {
    margin: 0; position: relative; text-align: center;
    font-family: var(--font-logo); font-weight: 400; letter-spacing: 0.015em;
  }
  .ghost { visibility: hidden; }
  .ghost .wgap { display: inline-block; width: 0.3em; }
  .key-art {
    /* The art's wordmark is 210px type in a 1920px frame; at width 1920/210 em
       it renders at exactly 1em — the size the text wordmark had. The splatter
       overflows the h1 box without occupying layout space. */
    position: absolute; left: 50%; top: 50%;
    width: calc(1920 / 210 * 1em); height: auto; max-width: none;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
</style>

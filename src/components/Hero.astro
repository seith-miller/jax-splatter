---
import { site } from '../data/site';
---

<section id="top" class="hero scanlines" aria-label="Intro">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="kicker">{site.tagline}</p>
    <h1>{site.name}</h1>
    <p class="statement">{site.heroStatement}</p>
  </div>
</section>

<style>
  /* Shorter than a full viewport on purpose: the link hub sits immediately
     below and must be visible without a scroll on a phone (decisions.md D9). */
  .hero { min-height: min(46vh, 24rem); display: grid; align-items: center; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(80% 60% at 75% 15%, rgba(70,179,255,0.20), transparent 55%),
      radial-gradient(70% 50% at 15% 95%, rgba(255,45,85,0.14), transparent 55%),
      linear-gradient(180deg, #06080e 0%, #05060a 60%, #04050a 100%);
  }
  .hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background-image:
      linear-gradient(transparent 0 2px, rgba(70,179,255,0.04) 2px 3px);
    background-size: 100% 3px; opacity: 0.6;
  }
  .hero-inner { position: relative; z-index: 1; padding-block: clamp(2rem, 5vw, 3.25rem); }
  .kicker {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.34em; font-size: 0.85rem; color: var(--blue);
    margin: 0 0 0.75rem;
  }
  h1 { margin: 0; text-shadow: 0 0 38px rgba(70,179,255,0.28); }
  .statement {
    max-width: 34ch; font-size: clamp(1.05rem, 1rem + 0.6vw, 1.4rem);
    color: var(--fg-dim); margin: 1rem 0 0;
  }
</style>
